+/** Resident preparation consumes the same public-basis source as bounded J/K.
+ * Only host A/M outputs are complete; device staging is capped at 64 MiB.
+ * This avoids a second Cartesian tensor and the reference host transform.
+ * The explicit Cartesian integral API remains an independent comparison path.
+ */
+vibeqc_status build_cuda_density_fitting_public_values_batch(
+    int device_id, const std::vector<core::System>& orbital,
+    const std::vector<core::System>& auxiliary,
+    std::vector<integrals::DensityFittingIntegralData>& outputs, std::string& detail) {
+  outputs.clear();
+  CudaDensityFittingIntegralSource* raw_source = nullptr;
+  std::vector<double> metric;
+  std::size_t n = 0, a = 0;
+  auto status = create_cuda_density_fitting_integral_source(device_id, orbital, auxiliary,
+                                                            &raw_source, metric, n, a, detail);
+  if (status != VIBEQC_STATUS_SUCCESS) return status;
+  const std::unique_ptr<CudaDensityFittingIntegralSource,
+                        decltype(&destroy_cuda_density_fitting_integral_source)>
+      source(raw_source, destroy_cuda_density_fitting_integral_source);
+  std::size_t pairs = 0, elements = 0, bytes = 0;
+  if (!cuda_execution::checked_multiply(n, n, pairs) ||
+      !cuda_execution::checked_multiply(pairs, a, elements) ||
+      !cuda_execution::checked_multiply(elements, sizeof(double), bytes)) {
+    detail = "public DF export dimensions overflow";
+    return VIBEQC_STATUS_OUT_OF_MEMORY;
+  }
+  const auto tile = std::min({pairs, std::size_t{8192}, (64U << 20) / (a * sizeof(double))});
+  if (!tile) {
+    detail = "public DF auxiliary row exceeds bounded export staging";
+    return VIBEQC_STATUS_OUT_OF_MEMORY;
+  }
+  cudaStream_t stream = nullptr;
+  double* device = nullptr;
+  auto cleanup = [&] {
+    // Host outputs and source metadata cannot die while an upload/readback
+    // still references them, including early error returns.
+    if (stream) (void)cudaStreamSynchronize(stream);
+    if (device) (void)runtime::resource_cuda_free(device);
+    if (stream) (void)cudaStreamDestroy(stream);
+  };
+  try {
+    std::vector<integrals::DensityFittingIntegralData> local(orbital.size());
+    for (std::size_t item = 0; item < local.size(); ++item) {
+      local[item].nbf = n;
+      local[item].naux = a;
+      local[item].ncoord = orbital[item].atoms.size() * 3;
+      local[item].metric.assign(metric.begin() + item * a * a, metric.begin() + (item + 1) * a * a);
+      local[item].three_center.resize(elements);
+    }
+    // Declare cleanup after host output storage so the stream drains first.
+    runtime::ResourceScopeExit guard(cleanup);
+    auto error = cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking);
+    if (error == cudaSuccess)
+      error = runtime::resource_cuda_malloc(&device, tile * a * sizeof(double));
+    if (error != cudaSuccess) return cuda_execution::source_cuda_status(error);
+    runtime::cuda_trace::TraceOperation trace("public_raw_value_export", stream,
+                                              {orbital.size(), n, a, true, false});
+    runtime::cuda_trace::trace_counter(
+        "source_metadata_device_bytes",
+        cuda_density_fitting_integral_source_device_bytes(source.get()));
+    runtime::cuda_trace::trace_counter("raw_export_device_staging_bytes",
+                                       tile * a * sizeof(double));
+    for (std::size_t item = 0; item < local.size(); ++item)
+      for (std::size_t begin = 0; begin < pairs; begin += tile) {
+        const auto count = std::min(tile, pairs - begin);
+        status = generate_cuda_density_fitting_raw_tile(source.get(), item, begin, count, 0, a, -1,
+                                                        stream, device, detail);
+        if (status != VIBEQC_STATUS_SUCCESS) return status;
+        error = cudaMemcpyAsync(local[item].three_center.data() + begin * a, device,
+                                count * a * sizeof(double), cudaMemcpyDeviceToHost, stream);
+        if (error == cudaSuccess) error = cudaStreamSynchronize(stream);
+        if (error != cudaSuccess) return cuda_execution::source_cuda_status(error);
+        runtime::cuda_trace::trace_counter("raw_export_values", count * a);
+        runtime::cuda_trace::trace_counter("raw_export_download_bytes", count * a * sizeof(double));
+      }
+    outputs.swap(local);
+    return VIBEQC_STATUS_SUCCESS;
+  } catch (const std::bad_alloc&) {
+    detail = "public DF export exceeded host storage";
+    return VIBEQC_STATUS_OUT_OF_MEMORY;
+  } catch (const std::exception& error) {
+    detail = error.what();
+    return VIBEQC_STATUS_INVALID_ARGUMENT;
+  }
+}
