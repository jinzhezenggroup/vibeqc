+        "template<unsigned Math> static __device__ __forceinline__ double three_center(",
+        "    double alpha,Vec3 A,Angular a,double beta,Vec3 B,Angular b,double gamma,Vec3 C,Angular c) {",
+        "  if constexpr(Math!=0) {",
