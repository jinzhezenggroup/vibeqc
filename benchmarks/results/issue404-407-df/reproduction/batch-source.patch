+        "  }",
+        "  return generated_df::three_center(alpha,A,a,beta,B,b,gamma,C,c);",
+        "}",
+        "} // namespace vibeqc::scf::generated_df_value_candidates",
+        "",
+    ]
+    return "\n".join(lines)
