+template <unsigned A, unsigned B, unsigned C, unsigned Variant>
+__device__ __forceinline__ void contract_owner_block(
+    DfShellBasisView first, DfShellBasisView second, DfShellBasisView auxiliary,
+    const double* positions, std::size_t panel_begin, std::size_t panel_count,
+    const double* weights, double* gradient, unsigned long long* counters, DfDerivativePairs pairs,
+    bool triangle, std::size_t block, std::size_t tasks, unsigned long long* work) {
+  using Schedule = generated::Schedule<A, B, C, Variant>;
+  const unsigned lane = threadIdx.x % Schedule::lanes;
+  const unsigned group = threadIdx.x / Schedule::lanes;
+  const auto c_group = auxiliary_group<Schedule>(first, second, auxiliary);
+  if constexpr (Schedule::auxiliary_group == 1) {
+    contract_shell_task<A, B, C, Variant>(first, second, auxiliary, positions, panel_begin,
+                                          panel_count, weights, gradient, counters, pairs, triangle,
+                                          block * Schedule::groups + group, tasks, work, nullptr);
+  } else {
+    static_assert(Schedule::lanes * Schedule::auxiliary_group <= 32);
+    static_assert(32 % (Schedule::lanes * Schedule::auxiliary_group) == 0);
+    if (c_group == 1) {
+      contract_shell_task<A, B, C, Variant>(
+          first, second, auxiliary, positions, panel_begin, panel_count, weights, gradient,
+          counters, pairs, triangle, block * Schedule::groups + group, tasks, work, nullptr);
+      return;
+    }
+    __shared__ OrbitalPartial partials[Schedule::groups];
+    if (lane == 0) partials[group].active = false;
+    const auto chunks = (auxiliary.count[C] + c_group - 1) / c_group;
+    const auto owner = block * (Schedule::groups / c_group) + group / c_group;
+    const auto c_index = (owner % chunks) * c_group + group % c_group;
+    const auto task = owner < owner_count<Schedule>(tasks, auxiliary.count[C], c_group) &&
+                              c_index < auxiliary.count[C]
+                          ? (owner / chunks) * auxiliary.count[C] + c_index
+                          : tasks;
+    contract_shell_task<A, B, C, Variant>(first, second, auxiliary, positions, panel_begin,
+                                          panel_count, weights, gradient, counters, pairs, triangle,
+                                          task, tasks, work, partials + group);
