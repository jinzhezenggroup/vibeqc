+/** Prove the public expansion contract independently of generated indexing.
+ * Products of these one-to-one maps remain injective after a triangle/panel
+ * removes tuples. Spherical d/f deliberately demonstrate collisions and must
+ * keep the general folding path even when individual AOs have one term.
+ */
+void check_public_weight_ownership() {
+  for (const auto representation : {VIBEQC_BASIS_CARTESIAN, VIBEQC_BASIS_SPHERICAL})
+    for (unsigned l = 0; l < 4; ++l) {
+      const auto cartesian = molecule::cartesian_components(l);
+      const auto expansions = molecule::ao_expansions(l, representation);
+      std::vector<unsigned> owners(cartesian.size());
+      bool identity = expansions.size() == cartesian.size();
+      for (std::size_t ao = 0; ao < expansions.size(); ++ao) {
+        identity = identity && expansions[ao].size() == 1;
+        for (const auto& term : expansions[ao]) {
+          const auto found = std::find(cartesian.begin(), cartesian.end(), term.component);
+          require(found != cartesian.end(),
+                  "public expansion names an invalid Cartesian component");
+          const auto index = static_cast<std::size_t>(found - cartesian.begin());
+          ++owners[index];
+          identity = identity && index == ao && term.coefficient == 1.0;
+          if (l < 2)
+            require(
+                term.coefficient * molecule::cartesian_component_normalization(term.component) ==
+                    1.0,
+                "s/p identity weights require exact unit component normalization");
+        }
+      }
+      if (representation == VIBEQC_BASIS_CARTESIAN || l < 2) {
+        require(
+            identity && std::all_of(owners.begin(), owners.end(), [](auto n) { return n == 1; }),
+            "direct weight ownership requires the exact public CCA identity map");
+      } else {
+        require(
+            !identity && std::any_of(owners.begin(), owners.end(), [](auto n) { return n > 1; }),
+            "spherical d/f expansions must exercise the collision fallback");
+      }
+    }
+}
