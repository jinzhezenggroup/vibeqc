--- /dev/null
+++ b/python/vibeqc_compiler/integral/df_rys.py
@@ -0,0 +1,247 @@
+"""Independently owned one/two-root quadrature for generated DF derivatives.
+
+Nodes are t^2, not the transformed u=t^2/(1-t^2) convention used by some Rys
+implementations. The weights integrate exp(-T*t^2) on t in [0,1]. One root
+reproduces moments through degree one; two roots reproduce degree three.
+Normal source emission only reads committed FP64 coefficients and uses the
+standard library. Regeneration alone needs mpmath at 75 decimal digits.
+"""
+
+import argparse
+import math
+from pathlib import Path
+
+from .df_rys2_data import COEFFICIENTS
+
+SEGMENT_WIDTH = 2
+SEGMENTS = 30
+COEFFICIENT_COUNT = 16
+ASYMPTOTIC_ARGUMENT = SEGMENT_WIDTH * SEGMENTS
+TAYLOR_COEFFICIENTS = tuple(
+    tuple(1.0 / (math.factorial(k) * (2 * k + 2 * order + 1)) for k in range(25))
+    for order in (0, 1)
+)
+
+
+def rys_roots(argument, nroots):
+    """Evaluate FP64 t^2 nodes and weights for emission/oracle comparisons.
+
+    This host implementation is a compiler validation aid, never a production
+    force dependency. The generated CUDA evaluator follows the same bounded
+    operations. Large-T formulas form roots before moments can underflow.
+    """
+    if not math.isfinite(argument) or argument < 0 or nroots not in (1, 2):
+        raise ValueError("DF Rys requires finite T >= 0 and one or two roots")
+    if nroots == 1:
+        if argument < 0.5:
+            moments = []
+            for coefficients in TAYLOR_COEFFICIENTS:
+                value = 0.0
+                for coefficient in reversed(coefficients):
+                    value = -argument * value + coefficient
+                moments.append(value)
+            return (moments[1] / moments[0],), (moments[0],)
+        weight = (
+            0.5
+            * math.sqrt(math.pi)
+            * math.erf(math.sqrt(argument))
+            / math.sqrt(argument)
+        )
+        root = (0.5 / argument) * (1.0 - math.exp(-argument) / weight)
+        return (root,), (weight,)
+    if argument >= ASYMPTOTIC_ARGUMENT:
+        # Generalized Laguerre alpha=-1/2: the omitted tail after T=60 is
+        # checked against the finite-interval moments on the validation grid.
+        sqrt6 = math.sqrt(6)
+        f0 = 0.5 * math.sqrt(math.pi) / math.sqrt(argument)
+        fraction = 0.5 + 1 / sqrt6
+        return (
+            (1.5 - 0.5 * sqrt6) / argument,
+            (1.5 + 0.5 * sqrt6) / argument,
+        ), (f0 * fraction, f0 * (1 - fraction))
+    interval = int(argument / SEGMENT_WIDTH)
+    x = argument - interval * SEGMENT_WIDTH - 1
+    values = []
+    for coefficients in COEFFICIENTS[interval]:
+        b1 = b2 = 0.0
+        for coefficient in coefficients[:0:-1]:
+            current = coefficient + 2 * x * b1 - b2
+            b2, b1 = b1, current
+        values.append(coefficients[0] + x * b1 - b2)
+    return tuple(values[:2]), tuple(values[2:])
+
+
+def reference_roots(argument, nroots):
+    """Construct Gaussian quadrature from high-accuracy defining moments.
+
+    This independent reference uses incomplete gamma integrals and a symmetric
+    two-by-two Jacobi matrix, not the fitted table or emitted evaluator. Scaling
+    moments by max(1,T)^k protects the eigenproblem across extreme T values.
+    The caller controls mpmath precision with workdps().
+    """
+    import mpmath as mp
+
+    if nroots not in (1, 2):
+        raise ValueError("reference supports one or two roots")
+    t = mp.mpf(argument)
+    if not mp.isfinite(t) or t < 0:
+        raise ValueError("reference requires finite T >= 0")
+    if t == 0:
+        f = [mp.mpf(1) / (2 * k + 1) for k in range(2 * nroots)]
+    else:
+        f = [
+            mp.gammainc(k + mp.mpf("0.5"), 0, t) / (2 * t ** (k + mp.mpf("0.5")))
+            for k in range(2 * nroots)
+        ]
+    if nroots == 1:
+        return (f[1] / f[0],), (f[0],)
+    scale = max(mp.mpf(1), t)
+    m = [f[k] / f[0] * scale**k for k in range(4)]
+    a = m[1]
+    variance = m[2] - a * a
+    b = (m[3] - 2 * a * m[2] + a**3) / variance
+    middle = (a + b) / 2
+    radius = mp.sqrt(((a - b) / 2) ** 2 + variance)
+    low, high = middle - radius, middle + radius
+    fraction = (high - a) / (high - low)
+    return (low / scale, high / scale), (f[0] * fraction, f[0] * (1 - fraction))
+
+
+def generate_coefficients():
+    """Regenerate every committed FP64 coefficient from 75-digit moments."""
+    import mpmath as mp
+
+    with mp.workdps(75):
+        count = COEFFICIENT_COUNT
+        angles = [mp.pi * (k + mp.mpf("0.5")) / count for k in range(count)]
+        cosines = [mp.cos(angle) for angle in angles]
+        tables = []
+        for interval in range(SEGMENTS):
+            samples = []
+            for x in cosines:
+                roots, weights = reference_roots(
+                    interval * SEGMENT_WIDTH + (x + 1) * SEGMENT_WIDTH / 2, 2
+                )
+                samples.append((*roots, *weights))
+            coefficients = []
+            for observable in range(4):
+                row = [
+                    2
+                    * sum(
+                        sample[observable] * mp.cos(j * angle)
+                        for sample, angle in zip(samples, angles, strict=True)
+                    )
+                    / count
+                    for j in range(count)
+                ]
+                row[0] /= 2
+                coefficients.append(tuple(float(value) for value in row))
+            tables.append(tuple(coefficients))
+    return tuple(tables)
+
+
+def emit_df_rys_cuda():
+    """Emit the independent evaluator without importing any runtime or oracle.
+
+    A read-only device table avoids constant-memory broadcast serialization when
+    compact subgroups in one warp select different intervals. Source operation
+    counts describe this evaluator; hardware-cache behavior requires profiling.
+    """
+    table = ",\n".join(
+        "  {" + ",".join("{" + ",".join(map(repr, row)) + "}" for row in interval) + "}"
+        for interval in COEFFICIENTS
+    )
+    taylor = ",\n".join(
+        "  {" + ",".join(map(repr, row)) + "}" for row in TAYLOR_COEFFICIENTS
+    )
+    return (
+        r"""// Independently generated DF Rys quadrature; nodes are t^2.
+#ifndef VIBEQC_GENERATED_DF_RYS_CUH
+#define VIBEQC_GENERATED_DF_RYS_CUH
+#include <cmath>
+namespace vibeqc::scf::generated_df_rys {
+static __device__ const double two_root_coefficients[30][4][16] = {
+"""
+        + table
+        + r"""
+};
+static __device__ const double taylor_coefficients[2][25] = {
+"""
+        + taylor
+        + r"""
+};
+/** Precondition: finite argument >= 0. Output uses the defining integral on [0,1]. */
+template<unsigned N>
+__device__ __forceinline__ void roots(double argument,double* nodes,double* weights) {
+  static_assert(N==1 || N==2);
+  constexpr double sqrt_pi_over_two=0.88622692545275801365;
+  if constexpr(N==1) {
+    if(argument<0.5) {
+      double moments[2]{};
+#pragma unroll
+      for(unsigned order=0;order<2;++order) {
+        double value=0;
+#pragma unroll
+        for(int k=24;k>=0;--k) value=fma(-argument,value,taylor_coefficients[order][k]);
+        moments[order]=value;
+      }
+      nodes[0]=moments[1]/moments[0];weights[0]=moments[0];
+    } else {
+      const double square_root=sqrt(argument);
+      weights[0]=sqrt_pi_over_two*erf(square_root)/square_root;
+      nodes[0]=(0.5/argument)*(1-exp(-argument)/weights[0]);
+    }
+  } else {
+    if(argument>=60) {
+      constexpr double sqrt6=2.4494897427831780982;
+      constexpr double fraction=0.5+1/sqrt6;
+      const double f0=sqrt_pi_over_two/sqrt(argument);
+      nodes[0]=(1.5-0.5*sqrt6)/argument;nodes[1]=(1.5+0.5*sqrt6)/argument;
+      weights[0]=f0*fraction;weights[1]=f0*(1-fraction);
+    } else {
+      const unsigned interval=static_cast<unsigned>(argument*0.5);
+      const double x=argument-2*interval-1;
+      double values[4];
+#pragma unroll
+      for(unsigned observable=0;observable<4;++observable) {
+        const auto* coefficients=two_root_coefficients[interval][observable];
+        double b1=0,b2=0;
+#pragma unroll
+        for(int k=15;k>=1;--k) {
+          const double current=fma(2*x,b1,coefficients[k]-b2);
+          b2=b1;b1=current;
+        }
+        values[observable]=fma(x,b1,coefficients[0]-b2);
+      }
+      nodes[0]=values[0];nodes[1]=values[1];weights[0]=values[2];weights[1]=values[3];
+    }
+  }
+}
+} // namespace vibeqc::scf::generated_df_rys
+#endif
+"""
+    )
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--regenerate", action="store_true")
+    args = parser.parse_args()
+    if not args.regenerate:
+        parser.error(
+            "specify --regenerate to verify independent coefficient provenance"
+        )
+    # Verification keeps formatting/metadata intact and fails on stale tables.
+    generated = generate_coefficients()
+    if generated != COEFFICIENTS:
+        target = Path(__file__).with_name("df_rys2_data.py")
+        raise ValueError(
+            f"committed coefficients differ from regenerated values: {target}"
+        )
+    print(
+        "Verified 1,920 independently generated FP64 coefficients at 75 decimal digits"
+    )
+
+
+if __name__ == "__main__":
+    main()
