+    probe.resolve.argtypes = [
+        ctypes.c_bool,
+        ctypes.c_uint64,
+        ctypes.c_uint64,
+        ctypes.POINTER(ctypes.c_uint64),
+    ]
+    probe.resolve.restype = ctypes.c_bool
+    return probe
+
+
+@pytest.fixture(autouse=True)
+def empty_policy(monkeypatch):
+    for suffix in ("", *("_" + name for name in NAMES)):
+        monkeypatch.delenv("VIBEQC_DF_SHELL_MATH" + suffix, raising=False)
+
+
+def resolve(probe, available=1, qualified=0, *, saved=False):
+    result = ctypes.c_uint64()
+    if not probe.resolve(saved, available, qualified, ctypes.byref(result)):
+        raise ValueError("invalid or unavailable shell math")
+    return result.value
+
+
+def test_automatic_promotion_requires_generated_and_qualified_class(policy_probe):
+    assert resolve(policy_probe) == 0
+    assert resolve(policy_probe, qualified=3) == 1
+    assert resolve(policy_probe, available=0, qualified=1) == 0
+
+
+@pytest.mark.parametrize("name,index", tuple(zip(NAMES, INDICES, strict=True)))
+def test_named_class_override_and_snapshot(policy_probe, monkeypatch, name, index):
+    bit = 1 << index
+    monkeypatch.setenv("VIBEQC_DF_SHELL_MATH_" + name, "rys")
+    assert resolve(policy_probe, available=bit) == bit
+    policy_probe.snapshot()
+    assert policy_probe.matches()
+    monkeypatch.setenv("VIBEQC_DF_SHELL_MATH_" + name, "polynomial")
+    assert not policy_probe.matches()
+    assert resolve(policy_probe, available=bit, qualified=bit) == 0
+    assert resolve(policy_probe, available=bit, saved=True) == bit
+    with pytest.raises(ValueError):
+        resolve(policy_probe, available=0, saved=True)
+
+
+def test_global_rys_keeps_unimplemented_classes_polynomial(policy_probe, monkeypatch):
+    monkeypatch.setenv("VIBEQC_DF_SHELL_MATH", "rys")
+    assert resolve(policy_probe) == 1
+    monkeypatch.setenv("VIBEQC_DF_SHELL_MATH_000", "auto")
+    assert resolve(policy_probe) == 0
+    assert resolve(policy_probe, qualified=1) == 1
+    monkeypatch.setenv("VIBEQC_DF_SHELL_MATH_001", "rys")
+    with pytest.raises(ValueError):
+        resolve(policy_probe)
+
+
+@pytest.mark.parametrize("name", ("VIBEQC_DF_SHELL_MATH", "VIBEQC_DF_SHELL_MATH_000"))
+@pytest.mark.parametrize("value", ("", "RYS", "bogus"))
+def test_invalid_values_do_not_silently_change_lowering(
+    policy_probe, monkeypatch, name, value
+):
+    policy_probe.snapshot()
+    monkeypatch.setenv(name, value)
+    assert not policy_probe.matches()
+    with pytest.raises(ValueError):
+        resolve(policy_probe)
