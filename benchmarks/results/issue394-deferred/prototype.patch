+          // Reconstruct sharing from physical atoms, independently of the
+          // generated center-recovery formula and device diagnostics.
+          const auto atom_a = first.atom_index, atom_b = second.atom_index;
+          const auto atom_c = third.atom_index;
+          const unsigned shared = 3 * (unsigned(atom_a == atom_b || atom_a == atom_c) +
+                                       unsigned(atom_b == atom_a || atom_b == atom_c) +
+                                       unsigned(atom_c == atom_a || atom_c == atom_b));
+          counts[0] += 3;
+          counts[1] += 3;
+          counts[2] += 3;
+          counts[3] += shared;
+          counts[4] += 9 - shared;
+          // No orbital partials are combined across C shells in this owner.
+          ++counts[6];
+        }
+      }
+    }
+  return result;
+}
