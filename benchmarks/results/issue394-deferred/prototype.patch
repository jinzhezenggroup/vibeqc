+using GradientWork = std::array<unsigned long long, 7>;
+std::map<Signature, GradientWork> gradient_work(const core::System& orbital,
+                                                const core::System& auxiliary,
+                                                const std::vector<double>& dense,
+                                                const std::vector<double>& packed, std::size_t cap,
+                                                scf::DfDerivativePairs pairs) {
+  const auto offsets = [](const core::System& system) {
+    std::vector<std::size_t> values{0};
+    for (const auto& shell : system.shells)
+      values.push_back(
+          values.back() +
+          molecule::ao_expansions(shell.angular_momentum, system.basis_representation).size());
+    return values;
+  };
+  const auto oa = offsets(orbital), ox = offsets(auxiliary);
+  const auto n = oa.back(), a = ox.back(), stride = n * (n + 1) / 2;
+  std::map<Signature, GradientWork> result;
+  for (std::size_t sa = 0; sa < orbital.shells.size(); ++sa)
+    for (std::size_t sb = 0; sb < orbital.shells.size(); ++sb) {
+      const auto& first = orbital.shells[sa];
+      const auto& second = orbital.shells[sb];
+      const auto ka = std::pair(first.angular_momentum, first.primitives.size());
+      const auto kb = std::pair(second.angular_momentum, second.primitives.size());
+      if (pairs != scf::DfDerivativePairs::full && (ka < kb || (ka == kb && sa < sb))) continue;
+      for (std::size_t sc = 0; sc < auxiliary.shells.size(); ++sc) {
+        const auto& third = auxiliary.shells[sc];
+        auto& counts = result[{ka.first, kb.first, third.angular_momentum, ka.second, kb.second,
+                               third.primitives.size()}];
+        for (std::size_t begin = 0; begin < a; begin += cap) {
+          bool active = false;
+          for (auto ci = std::max(begin, ox[sc]); ci < std::min(begin + cap, ox[sc + 1]); ++ci)
+            for (auto ai = oa[sa]; ai < oa[sa + 1]; ++ai)
+              for (auto bi = oa[sb]; bi < oa[sb + 1]; ++bi) {
+                double weight;
+                if (pairs == scf::DfDerivativePairs::packed) {
+                  if (sa == sb && ai < bi) continue;
+                  const auto hi = std::max(ai, bi), lo = std::min(ai, bi);
+                  weight = packed[ci * stride + hi * (hi + 1) / 2 + lo];
+                } else {
