index 0000000..2176fc3
--- /dev/null
+++ b/src/scf/df_shell_math_policy.hpp
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <stdexcept>
+#include <string_view>
+
+namespace vibeqc::scf {
+/** Requested shell lowering, frozen with the prepared derivative source.
+ * Global Rys applies to the compiler's available classes. An explicit class
+ * override must be implemented, so unsupported requests cannot silently pass.
+ * Automatic selection is restricted separately by the qualified-class mask.
+ */
+struct DfShellMathPolicy {
+  enum class Choice : unsigned char { inherit, automatic, polynomial, rys, invalid };
+  Choice global{Choice::automatic};
+  std::array<Choice, 7> classes{};
+  bool operator==(const DfShellMathPolicy&) const = default;
+
+  // These are diagnostic selector names, not a second recurrence inventory.
+  static constexpr std::array<const char*, 7> names{
+      "VIBEQC_DF_SHELL_MATH_000", "VIBEQC_DF_SHELL_MATH_001", "VIBEQC_DF_SHELL_MATH_002",
+      "VIBEQC_DF_SHELL_MATH_100", "VIBEQC_DF_SHELL_MATH_101", "VIBEQC_DF_SHELL_MATH_110",
+      "VIBEQC_DF_SHELL_MATH_200"};
+  static constexpr std::array<unsigned, 7> indices{0, 1, 2, 16, 17, 20, 32};
+
+  /** Compact lossless token for the existing 32-byte C diagnostic field.
+   * Order is global then 000/001/002/100/101/110/200; '-' inherits, 'a' is
+   * automatic, 'p' polynomial, 'r' Rys, and 'x' an invalid request.
+   */
+  std::array<char, 9> token() const noexcept {
+    constexpr char codes[] = "-aprx";
+    std::array<char, 9> result{};
+    result[0] = codes[static_cast<unsigned>(global)];
+    for (unsigned i = 0; i < classes.size(); ++i)
+      result[i + 1] = codes[static_cast<unsigned>(classes[i])];
+    return result;
+  }
+
+  /** Resolve policy against generated availability and measured promotion.
+   * Bit 16*A+4*B+C identifies a class. Unavailable automatic classes remain
+   * polynomial; a named forced class fails before any derivative launch.
+   */
+  std::uint64_t resolve(std::uint64_t available, std::uint64_t qualified) const {
+    if (global == Choice::invalid || global == Choice::inherit)
+      throw std::invalid_argument("unknown DF shell math (use auto, polynomial or rys)");
+    auto selected = global == Choice::rys         ? available
+                    : global == Choice::automatic ? available & qualified
+                                                  : std::uint64_t{0};
+    for (unsigned i = 0; i < classes.size(); ++i) {
+      const auto choice = classes[i];
+      const auto bit = std::uint64_t{1} << indices[i];
+      if (choice == Choice::invalid)
+        throw std::invalid_argument(
+            "unknown per-class DF shell math (use auto, polynomial or rys)");
+      if (choice == Choice::rys && !(available & bit))
+        throw std::invalid_argument("requested DF shell Rys class is not generated");
+      if (choice == Choice::inherit) continue;
+      selected &= ~bit;
+      if (choice == Choice::rys || (choice == Choice::automatic && (qualified & available & bit)))
+        selected |= bit;
+    }
+    return selected;
+  }
+};
+
+/** Parse without throwing so prepared-cache matching remains noexcept.
+ * Invalid values are retained in provenance and rejected by resolve().
+ */
+inline DfShellMathPolicy requested_df_shell_math() noexcept {
+  using Choice = DfShellMathPolicy::Choice;
+  const auto parse = [](const char* name, Choice missing) {
+    const char* raw = std::getenv(name);
+    if (!raw) return missing;
+    const std::string_view value(raw);
+    return value == "auto"         ? Choice::automatic
+           : value == "polynomial" ? Choice::polynomial
+           : value == "rys"        ? Choice::rys
+                                   : Choice::invalid;
+  };
+  DfShellMathPolicy policy;
+  policy.global = parse("VIBEQC_DF_SHELL_MATH", Choice::automatic);
+  for (unsigned i = 0; i < policy.classes.size(); ++i)
+    policy.classes[i] = parse(DfShellMathPolicy::names[i], Choice::inherit);
+  return policy;
+}
+}  // namespace vibeqc::scf
