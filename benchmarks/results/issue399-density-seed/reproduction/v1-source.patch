+  for (std::size_t i = 0; i < values.size(); ++i) {
+    const double value = values[i];
+    if (!std::isfinite(value) || value < -spectral_threshold || (i && value < values[i - 1])) {
+      trace_counter("spectrum_rejected", 1);
