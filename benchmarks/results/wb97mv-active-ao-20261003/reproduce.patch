+"""Clean full-Fock reference control using the unchanged complete comparator.
+
+All hooks record metadata after clean timers stop. Each engine computes its own
+density; only the reference convergence controls and shared active-density domain
+are specified here. Source snapshots and binary hashes live in the bundle receipt.
+"""
+import copy
+import numpy as np
+import importlib.util
+from pathlib import Path
+import os
+
+root = Path(os.environ['ACTIVE_AO_ROOT'])
+spec = importlib.util.spec_from_file_location('complete_cold_benchmark', root/'complete-cold-benchmark.py')
+benchmark = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(benchmark)
+spec = importlib.util.spec_from_file_location('ao_work', root/'ao-work.py')
+ao_work = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(ao_work)
+from benchmarks import compare_gpu4pyscf_batch as common
+from benchmarks.compare_df_direct_endpoint import reference_work_counter
+
+
+# SCF discovery is opt-in at native plan creation and belongs to preparation.
+# Force maps are a separate order-2 selection discovered on first execution.
+from generativeqc._stationary_composite_cuda import PreparedCompositeStationaryCudaGradient
+mode = os.environ['ACTIVE_AO_MODE']
+assert mode in ('dense', 'sparse')
+assert os.environ['GENERATIVEQC_CUDA_KS_ACTIVE_AO'] == ('1' if mode == 'sparse' else '0')
+original_execute = PreparedCompositeStationaryCudaGradient.execute
+
+def execute(self, *args, **kwargs):
+    kwargs.update(active_ao_cutoff=1e-16 if mode == 'sparse' else None,
+                  active_ao_cache_bytes=64 << 20)
+    return original_execute(self, *args, **kwargs)
+
+PreparedCompositeStationaryCudaGradient.execute = execute
+
+original_engine = benchmark.reference_engine
+original_reference_sample = benchmark.reference_sample
+original_native_sample = common._generativeqc_sample
+reference_cold = None
+
+
+def reference_engine(*args, **kwargs):
+    kwargs["full_fock"] = True
+    engine = original_engine(*args, **kwargs)
+    engine.conv_tol = 1e-11
+    engine.conv_tol_grad = 1e-8
+    engine.direct_scf_tol = 1e-14
+    return engine
+
+
+def reference_sample(engine, *args, **kwargs):
+    global reference_cold
+    with benchmark.reference_vv10_domain(1e-8) as domain:
+        with reference_work_counter(engine) as work:
+            result = original_reference_sample(engine, *args, **kwargs)
+        result['scf_jk_builds'] = work['scf_jk_builds']
+        result['vv10_density_thresholds'] = dict(domain)
+    from gpu4pyscf.dft.numint import _init_xcfuns
+    result['reference_xc_backend'] = [
+        {'id': int(x.func_id), 'weight': float(w), 'on_gpu': bool(x.on_gpu)}
+        for x, w in _init_xcfuns(engine.xc, engine.mol.spin)]
+    result["reference_fock_policy"] = "full-density get_veff; suppress dm_last and vhf_last"
+    # Validation occurs after the complete endpoint timer. Each replay uses
+    # this reference engine's own fixed post-cold density, as the harness requires.
+    if reference_cold is None:
+        reference_cold = copy.deepcopy(result)
+    errors = {}
+    for key, gate in (("energies_hartree", 1e-8), ("forces_hartree_per_bohr", 1e-7)):
+        actual, expected = np.asarray(result[key]), np.asarray(reference_cold[key])
+        assert actual.shape == expected.shape and np.isfinite(actual).all(), key
+        errors[key] = float(np.max(np.abs(actual - expected)))
+        assert errors[key] <= gate, (key, errors[key], gate)
+    result["reference_cold_consistency_errors"] = errors
+    return result
+
+
+def native_sample(batch, *args, **kwargs):
+    result = original_native_sample(batch, *args, **kwargs)
+    result['active_ao_experiment'] = dict(mode=mode, cutoff=1e-16 if mode == 'sparse' else None,
+        policy='explicit native SCF order1 and complete force order2 maps; SCF discovery charged in complete cold preparation')
+
+    work = ao_work.read_work(batch)
+    assert work['requested'] == work['selected'] == (1 if mode == 'sparse' else 0), work
+    assert work['xc_evaluations'] > 0
+    assert work['point_ao_square_sum'] <= work['dense_point_ao_square_sum']
+    result['native_scf_ao_work'] = work
+    result['native_scf_executed_point_ao_square_sum'] = work['xc_evaluations'] * work['point_ao_square_sum']
+    result['force_work'] = copy.deepcopy(batch._stationary_cuda_execution.last_work)
+    return result
+
+
+benchmark.reference_engine = reference_engine
+benchmark.reference_sample = reference_sample
+common._generativeqc_sample = native_sample
+benchmark.main()
