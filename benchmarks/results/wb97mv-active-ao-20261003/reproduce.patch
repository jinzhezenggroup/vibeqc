+"""Read current-result native selection counters without entering a device path."""
+import ctypes as ct
+
+COUNTERS = ('requested selected tiles empty_tiles min_active max_active active_sum '
+            'discovery_ao_jet_values point_ao_visits point_ao_square_sum '
+            'dense_point_ao_square_sum discovery_d2h_bytes reserved_device_bytes '
+            'host_peak_bytes xc_evaluations').split()
+class AoWork(ct.Structure):
+    _fields_ = [('struct_size', ct.c_uint32), ('abi_version', ct.c_uint32)] + [
+        (name, ct.c_uint64) for name in COUNTERS] + [
+        ('cutoff', ct.c_double), ('discovery_seconds', ct.c_double)]
+
+def read_work(batch, index=0):
+    function = batch._library.generativeqc_batch_get_ks_ao_selection_diagnostic_v1
+    function.argtypes = [ct.c_void_p, ct.c_uint32, ct.POINTER(AoWork)]
+    function.restype = ct.c_int
+    value = AoWork()
+    value.struct_size = ct.sizeof(value)
+    value.abi_version = 0
+    status = function(batch._batch, index, ct.byref(value))
+    assert status == 0, ('AO work status', status, index)
+    return {name: getattr(value, name) for name, _ in value._fields_[2:]}
