#include <cassert>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>
#include <quadmath.h>

using real = __float128;
#define GPU_DEVICE_FUNCTION
#define XC_FLAGS_HAVE_EXC 1
#define XC_FLAGS_HAVE_VXC 2
#define XC_FLAGS_NEEDS_LAPLACIAN 4
#define XC_FLAGS_NEEDS_TAU 8
@CONSTANTS@
#define POW_1_3(x) cbrtq(x)
#define POW_3_2(x) ((x) * sqrtq(x))
#define my_piecewise3(c, x, y) ((c) ? (x) : (y))
#define my_piecewise5(c, x, d, y, z) ((c) ? (x) : ((d) ? (y) : (z)))
struct info_type { int flags = XC_FLAGS_HAVE_EXC | XC_FLAGS_HAVE_VXC | XC_FLAGS_NEEDS_TAU; };
struct dim_type { int zk = 1, vrho = 2, vsigma = 3, vlapl = 2, vtau = 2; };
struct xc_func_type {
  void* params;
  real dens_threshold, zeta_threshold;
  info_type* info;
  dim_type dim;
};
struct xc_mgga_out_params { real *zk, *vrho, *vsigma, *vlapl, *vtau; };
@PARAMETERS@
@FORMULAS@

int main(int argc, char** argv) {
  if (argc != 3) return 2;
  FILE* file = fopen(argv[1], "rb");
  uint64_t count;
  if (!file || fread(&count, 8, 1, file) != 1 || count > 100000) return 3;
  std::vector<double> inputs(7 * count), outputs(8 * count);
  if (fread(inputs.data(), 8, inputs.size(), file) != inputs.size()) return 4;
  fclose(file);
  info_type info;
  mgga_c_m06l_params correlation{
    m062x_values[0], m062x_values[1], m062x_values[2], m062x_values[3],
    {m062x_values[4], m062x_values[5], m062x_values[6], m062x_values[7], m062x_values[8]},
    {m062x_values[9], m062x_values[10], m062x_values[11], m062x_values[12], m062x_values[13]},
    {m062x_values[14], m062x_values[15], m062x_values[16], m062x_values[17], m062x_values[18], m062x_values[19]},
    {m062x_values[20], m062x_values[21], m062x_values[22], m062x_values[23], m062x_values[24], m062x_values[25]},
    m062x_values[26]
  };
  mgga_x_m05_params exchange{
    {par_m06_2x[0], par_m06_2x[1], par_m06_2x[2], par_m06_2x[3],
     par_m06_2x[4], par_m06_2x[5], par_m06_2x[6], par_m06_2x[7],
     par_m06_2x[8], par_m06_2x[9], par_m06_2x[10], par_m06_2x[11]},
    par_m06_2x[12], par_m06_2x[13]
  };
  for (size_t index = 0; index < count; ++index) {
    const double* row = inputs.data() + 7 * index;
    real results[8] = {};
    for (int component = 0; component < 2; ++component) {
      const double floor = component ? 1e-15 : 1e-12;
      if (row[0] + row[1] < floor) continue;
      // Libxc's work_mgga performs admission and work clipping in binary64.
      const double sigma_threshold = std::pow(floor, 4.0 / 3.0);
      const double sigma_floor = sigma_threshold * sigma_threshold;
      const double work_rho[] = {std::fmax(floor, row[0]), std::fmax(floor, row[1])};
      double work_sigma[] = {std::fmax(sigma_floor, row[2]), row[3],
                             std::fmax(sigma_floor, row[4])};
      const double work_tau[] = {std::fmax(1e-20, row[5]), std::fmax(1e-20, row[6])};
      work_sigma[0] = std::fmin(work_sigma[0], 8.0 * work_rho[0] * work_tau[0]);
      work_sigma[2] = std::fmin(work_sigma[2], 8.0 * work_rho[1] * work_tau[1]);
      const double average = 0.5 * (work_sigma[0] + work_sigma[2]);
      work_sigma[1] = std::fmin(average, std::fmax(-average, work_sigma[1]));
      real rho[] = {work_rho[0], work_rho[1]};
      real sigma[] = {work_sigma[0], work_sigma[1], work_sigma[2]};
      real tau[] = {work_tau[0], work_tau[1]};
      xc_func_type state{component ? (void*)&exchange : (void*)&correlation,
                         floor, 0x1p-52Q, &info, {}};
      real values[8] = {};
      xc_mgga_out_params out{values, values + 1, values + 3, nullptr, values + 6};
      if (component) x_vxc(&state, 0, rho, sigma, nullptr, tau, &out);
      else c_vxc(&state, 0, rho, sigma, nullptr, tau, &out);
      values[0] *= real(row[0]) + real(row[1]);
      for (int field = 0; field < 8; ++field) results[field] += values[field];
    }
    for (int field = 0; field < 8; ++field)
      outputs[8 * index + field] = static_cast<double>(results[field]);
  }
  file = fopen(argv[2], "wb");
  if (!file || fwrite(&count, 8, 1, file) != 1 ||
      fwrite(outputs.data(), 8, outputs.size(), file) != outputs.size()) return 5;
  return fclose(file) == 0 ? 0 : 6;
}
