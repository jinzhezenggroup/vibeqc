{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jinzhezenggroup/vibeqc/tools/dft_mp_v1/result.schema.json",
  "title": "DFT-MP-v1 per-row result v1",
  "type": "object",
  "required": ["status", "row_id", "contract_sha256", "source_commit", "library_sha256", "artifact_sha256", "input_sha256", "basis_pack_sha256", "grid_identity", "method_version", "ao_count", "atom_count", "backend", "provider", "j_k", "basis_representation", "auxiliary", "ecp", "periodic", "attained_state", "reference_attained_state", "scf", "energy_eh", "independent_oracle", "precision"],
  "properties": {
    "status": {"const": "pass"}, "row_id": {"type": "string"},
    "contract_sha256": {"$ref": "#/$defs/sha"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "library_sha256": {"$ref": "#/$defs/sha"}, "artifact_sha256": {"$ref": "#/$defs/sha"},
    "input_sha256": {"$ref": "#/$defs/sha"}, "basis_pack_sha256": {"$ref": "#/$defs/sha"},
    "grid_identity": {"$ref": "#/$defs/sha"}, "method_version": {"type": "string"},
    "ao_count": {"type": "integer", "minimum": 1}, "atom_count": {"type": "integer", "minimum": 1},
    "backend": {"const": "cuda"}, "provider": {"const": "native-dft"}, "j_k": {"const": "direct"},
    "basis_representation": {"const": "real_spherical"}, "auxiliary": {"type": "null"}, "ecp": {"type": "null"}, "periodic": {"const": false},
    "attained_state": {"type": "string", "minLength": 1}, "reference_attained_state": {"type": "string", "minLength": 1},
    "scf": {"type": "object", "required": ["converged", "physical_residual", "final_forces_state", "screening_thresholds", "energy_tolerance_eh", "density_tolerance"]},
    "energy_eh": {"type": "number"},
    "forces_eh_per_bohr": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3}},
    "independent_oracle": {"type": "object", "required": ["provider", "raw", "source_sha256", "method_version", "basis_pack_sha256", "total_energy_error_eh", "energy_gate_eh"]},
    "checks": {"type": "object"},
    "precision": {"type": "object", "required": ["requested_mode", "native_provenance", "scf_fock_timeline", "operators"]},
    "strict_comparator": {"type": "object"}, "mixed_vs_strict": {"type": "object"},
    "online_scientific_cuda_compiles": {"type": "integer", "minimum": 0},
    "ablations": {"type": "object"}, "peak_simultaneous_bytes": {"type": "integer", "minimum": 0},
    "timing": {"type": "object"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
