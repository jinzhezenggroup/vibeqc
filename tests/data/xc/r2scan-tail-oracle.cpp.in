// Independent qualification driver adapted from Libxc 7.0.0 work_mgga_inc.c.
// MPL-2.0; see upstream/libxc/7.0.0/COPYING. No production compiler dependency.
#include <cassert>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>
#include <quadmath.h>

// Widen the original Libxc algebra, including its cancelling coordinates.
using real = __float128;
#define GPU_DEVICE_FUNCTION
#define XC_FLAGS_HAVE_EXC 1
#define XC_FLAGS_HAVE_VXC 2
#define XC_FLAGS_NEEDS_LAPLACIAN 4
#define XC_FLAGS_NEEDS_TAU 8
@CONSTANTS@
#define POW_1_3(x) cbrtq(x)
#define POW_1_4(x) sqrtq(sqrtq(x))
#define POW_3_2(x) ((x) * sqrtq(x))
#define my_piecewise3(c, x, y) ((c) ? (x) : (y))
#define my_piecewise5(c, x, d, y, z) ((c) ? (x) : ((d) ? (y) : (z)))
struct info_type { int flags = XC_FLAGS_HAVE_EXC | XC_FLAGS_HAVE_VXC | XC_FLAGS_NEEDS_TAU; };
struct dim_type { int zk = 1, vrho = 2, vsigma = 3, vlapl = 2, vtau = 2; };
struct xc_func_type {
  void* params;
  real dens_threshold, zeta_threshold;
  info_type* info;
  dim_type dim;
};
struct xc_mgga_out_params { real *zk, *vrho, *vsigma, *vlapl, *vtau; };
struct mgga_c_r2scan_params { real eta; };
struct mgga_x_r2scan_params { real c1, c2, d, k1, eta, dp2; };

@FORMULAS@

int main(int argc, char** argv) {
  if (argc != 3) return 2;
  FILE* file = fopen(argv[1], "rb");
  uint64_t count;
  if (!file || fread(&count, 8, 1, file) != 1 || count > 100000) return 3;
  std::vector<double> inputs(7 * count), outputs(8 * count);
  if (fread(inputs.data(), 8, inputs.size(), file) != inputs.size()) return 4;
  fclose(file);
  info_type info;
  mgga_c_r2scan_params correlation{0.001Q};
  mgga_x_r2scan_params exchange{0.667Q, 0.8Q, 1.24Q, 0.065Q, 0.001Q, 0.361Q};
  for (size_t i = 0; i < count; ++i) {
    const double* row = inputs.data() + 7 * i;
    real results[8] = {};
    for (int component = 0; component < 2; ++component) {
      const double density_floor = component ? 1e-11 : 1e-15;
      if (row[0] + row[1] < density_floor) continue;
      // Match the public work driver's FP64 thresholds/inputs. Its derivative
      // convention evaluates raw vxc at work inputs, without differentiating
      // the floors. Only the subsequent mathematical evaluation is widened.
      const double sigma_threshold = std::pow(density_floor, 4.0 / 3.0);
      const double sigma_floor = sigma_threshold * sigma_threshold;
      const double rho_work[] = {std::fmax(density_floor, row[0]),
                                 std::fmax(density_floor, row[1])};
      double sigma_work[] = {std::fmax(sigma_floor, row[2]), row[3],
                            std::fmax(sigma_floor, row[4])};
      const double limit = 0.5 * (sigma_work[0] + sigma_work[2]);
      sigma_work[1] = std::fmin(limit, std::fmax(-limit, sigma_work[1]));
      real rho[] = {rho_work[0], rho_work[1]};
      real sigma[] = {sigma_work[0], sigma_work[1], sigma_work[2]};
      real tau[] = {std::fmax(1e-20, row[5]), std::fmax(1e-20, row[6])};
      xc_func_type state{component ? (void*)&exchange : (void*)&correlation,
                         density_floor, 0x1p-52Q, &info, {}};
      real values[8] = {};
      xc_mgga_out_params out{values, values + 1, values + 3, nullptr, values + 6};
      if (component) x_vxc(&state, 0, rho, sigma, nullptr, tau, &out);
      else c_vxc(&state, 0, rho, sigma, nullptr, tau, &out);
      // zk is per particle. The production energy uses physical density.
      values[0] *= real(row[0]) + real(row[1]);
      for (int k = 0; k < 8; ++k) results[k] += values[k];
    }
    for (int k = 0; k < 8; ++k) outputs[8 * i + k] = static_cast<double>(results[k]);
  }
  file = fopen(argv[2], "wb");
  if (!file || fwrite(&count, 8, 1, file) != 1 ||
      fwrite(outputs.data(), 8, outputs.size(), file) != outputs.size()) return 5;
  return fclose(file) == 0 ? 0 : 6;
}
